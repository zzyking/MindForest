{
  "name": "mindforest",
  "version": "0.2.0",
  "private": true,
  "description": "MindForest v2 — file-as-truth knowledge forest. Markdown vault + Rust API + Vite/React frontend + Tauri desktop.",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@mindforest/web",
    "build": "npm run build --workspace=@mindforest/web",
    "preview": "npm run preview --workspace=@mindforest/web",
    "api": "cargo run -p api --manifest-path rust/Cargo.toml",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml --workspace",
    "rust:lint": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings"
  }
}

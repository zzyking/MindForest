# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — npm workspaces hoist all package deps to the root.
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build artifacts
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# rust
rust/target/
rust/apps/.tauri-dist/

# Swift sidecar build artifacts
rust/apps/embed-sidecar/.build/
rust/apps/embed-sidecar/Package.resolved

# vault contents (user data — lives outside repo in real use; .gitkeep only)
/vault/*
!/vault/.gitkeep

# web build output
/web/dist/
/web/node_modules/

# local notes / design docs (kept locally, not tracked)
CLAUDE.md
REFACTOR_PLAN.md
AGENTS.md

# Claude Code agent memory — lives outside repo at
# ~/.claude/projects/-Users-king-Documents-GitHub-mindforest/memory/
# This rule is defensive in case anything ever lands a `memory/` dir here again.
/memory/